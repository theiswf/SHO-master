---
import Button from "../components/Button.astro";
import SubLayout from "../layouts/SubLayout.astro";
import "../styles/tailwind.css";
import Sticker from "../components/Sticker.astro";

---

<SubLayout title="Aktuelle Stillinger" headerBG="/headeraktuellestillinger.svg" footerBG="/BG26.png.webp">
  <Sticker></Sticker>
<div class="text-(--color-text) bg-(--color-bg) pb-16 pt-25">
    <div class="mx-10 md:mx-50 lg:mx-80 pb-8">
          <h1 class="font-bold font-header text-mb-header lg:text-header text-center pt-4 mb-4">Aktuelle Stillinger</h1>
          <div class="font-body text-mb-body lg:text-[20px]">
              <p class="my-2 lg:my-4">På denne side kan du finde opslag om at komme i praktik eller blive frivillig, når vi aktivt leder efter folk.</p>
              <p class="my-2 lg:my-4">Studiepraktikanter søger vi som regel i april/maj for  efterårssemesteret og oktober/november for forårssemesteret. I løbet af  foråret rekrutterer vi desuden frivillige til Tinderbox, Generator,  Heartland og Spoken Word Festival.</p>
              <p class="my-2 lg:my-4">Du er altid velkommen til at  kontakte os, hvis du er interesseret i at blive praktikant eller  frivillig. Læs mere om, hvad de forskellige roller indebærer af opgaver her <a href="">Bliv Frivillig</a> og her <a href="">Praktik</a>.</p>
          </div>
    </div>
    
 <img class="absolute hidden lg:block right-20 top-50 sketch" src="/pencil-sketch.svg" alt="sketch">

    <div class="flex flex-col lg:flex-row items-center justify-center m-auto space-y-4 lg:space-y-0 lg:space-x-4">
        <div class="card w-96 shadow-lg bg-cover bg-[url('/BG15.png.webp')]">
            <div class="card-body">
              <h2 class="card-title font-header text-mb-subheader1 lg:text-subheader1">Open Call</h2>
              <p class="font-body text-mb-body lg:text-body pb-4">Foreningen Studenterhus Odense er en non-profit organisation, som drives af en mindre gruppe af fastansatte samt en række engagerede praktikanter og frivillige.</p>
              <div class="card-actions justify-end">
                <Button title="LÆS MERE OG SØG" href="/opencall"></Button>
              </div>
            </div>
        </div>
        <div class="card w-96 shadow-lg bg-cover bg-[url('/BG22.png.webp')]">
            <div class="card-body">
              <h2 class="card-title font-header text-mb-subheader1 lg:text-subheader1">Generator</h2>
              <p class="font-body text-mb-body lg:text-body pb-4">Foreningen Studenterhus Odense er en non-profit organisation, som drives af en mindre gruppe af fastansatte samt en række engagerede praktikanter og frivillige.</p>
              <div class="card-actions justify-end">
                <Button title="LÆS MERE OG SØG" href="https://www.generatorfestival.dk/"></Button>
              </div>
            </div>
        </div>
        <div class="card w-96 shadow-lg bg-cover bg-[url('/BG26.png.webp')]">
            <div class="card-body">
              <h2 class="card-title font-header text-mb-subheader1 lg:text-subheader1">Spoken Word</h2>
              <p class="font-body text-mb-body lg:text-body pb-4">Foreningen Studenterhus Odense er en non-profit organisation, som drives af en mindre gruppe af fastansatte samt en række engagerede praktikanter og frivillige.</p>
              <div class="card-actions justify-end">
                <Button title="LÆS MERE OG SØG" href="https://www.spoken.dk/"></Button>
              </div>
            </div>
        </div>
    </div>
</div>
</SubLayout>


<script>
        window.addEventListener("scroll", parallaxScroll);

function parallaxScroll() {
    const sketches = document.querySelectorAll(".sketch");
    const scrollSpeed = 0.25;
    const scrollY = window.scrollY;

    sketches.forEach(sketch => {
        sketch.style.transform = `translateY(${scrollY * scrollSpeed}px)`;
    });
}

</script>