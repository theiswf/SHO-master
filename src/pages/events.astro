---
import AllEvents from "../components/All_events.astro";
import Carousel from "../components/Carousel.astro";
import SubLayout from "../layouts/SubLayout.astro";
import Sticker from "../components/Sticker.astro";

---
<SubLayout title="Events" headerBG="/headerevents.svg" footerBG="/eventsbg.svg">
    <Sticker></Sticker>
	<div class="text-text bg-bg pt-25 pb-16">
        <div class="text-center pb-5 font-bold">
            <h1 class="font-header text-mb-header lg:text-header">THIS WEEK</h1>
        </div>
        <Carousel></Carousel>
        <hr class="border-black my-20 mx-8 md:mx-20">
        <div class="text-center pb-5 font-bold">
            <h1 class="font-header text-mb-header lg:text-header">ALL EVENTS</h1>
        </div>
        <AllEvents></AllEvents>
    </div>
</SubLayout>