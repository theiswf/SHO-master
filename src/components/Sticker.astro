<!-- Popup Menu -->
<div
  id="popupMenu"
  class="fixed right-4 bottom-[100px] z-50
         translate-x-full opacity-0
         transition-all duration-300 ease-out
         shadow-xl rounded-xl p-6 w-40 md:w-50 bg-[url('/burgermenubg2.svg')] bg-cover bg-center"
>
  <!-- Close button -->
  <button
      id="closePopup" 
      class="absolute top-12 md:top-14 right-2 hover:scale-115 transition cursor-pointer"
  >
  <img class="w-5" src="/arrow.svg" alt="">
  </button>

  <!-- Menu links -->
  <nav class="flex flex-col gap-4 text-mb-body md:text-body text-text font-body font-bold">
    <a href="/events" class="duration-200 hover:bg-[url(/eventsbg.svg)] hover:object-cover hover:bg-[70%_35%] hover:bg-clip-text hover:text-transparent">SE EVENTS</a>
    <a href="/volunteer" class="duration-200 hover:bg-[url(/BG22.png.webp)] hover:object-cover hover:bg-[40%_35%] hover:bg-clip-text hover:text-transparent">BLIV FRIVILLIG</a>
    <a href="/intern" class="duration-200 hover:bg-[url(/BG24.png.webp)] hover:object-cover hover:bg-[80%_35%] hover:bg-clip-text hover:text-transparent">BLIV PRAKTIKANT</a>
  </nav>
</div>

<!-- ✅ Reopen button MUST be OUTSIDE popup -->
<button
  id="openPopup"
  class="fixed right-4 bottom-[150px] z-40
         hidden
        text-text font-body font-bold
         px-4 py-2
         transition hover:scale-115 cursor-pointer"
>
  <img class="w-5 rotate-180" src="/arrow.svg" alt="">
</button>

<script>
    const menu = document.getElementById("popupMenu");
    const openBtn = document.getElementById("openPopup");
    const closeBtn = document.getElementById("closePopup");
  
    function openMenu() {
      menu.classList.remove("translate-x-full", "opacity-0");
      menu.classList.add("translate-x-0", "opacity-100");
      openBtn.classList.add("hidden");
    }
  
    function closeMenu() {
      menu.classList.add("translate-x-full", "opacity-0");
      openBtn.classList.remove("hidden");
    }
  
    window.addEventListener("load", openMenu);
    closeBtn.addEventListener("click", closeMenu);
    openBtn.addEventListener("click", openMenu);
  </script>
  