---
const { src, header, desc, list = [] } = Astro.props;
---
<section class="relative inline-block w-[300px] md:w-[350px] m-5 pt-8">
  <!-- Tape -->
  <img
    class="absolute top-0 left-1/2 -translate-x-1/2 z-10"
    src="/tape.svg"
    alt="tape"
  />

  <!-- Card BG -->
  <img
    class="absolute inset-0 w-full h-full object-cover drop-shadow-lg pointer-events-none"
    src="/paper-card.svg"
    alt="Paper Card Image"
  />

  <!-- Card Content -->
  <div class="relative flex flex-col px-5 pt-6 pb-12">
    <div class="flex justify-center mb-3">
      <img class="w-[50px] h-[50px]" src={src} alt="Icon" />
    </div>

    <h2 class="text-center font-subheader font-bold text-text text-mb-subheader2 md:text-subheader2">
      {header}
    </h2>

    <p class="font-body text-text text-mb-body md:text-body mt-2">
      {desc}
    </p>

    {list.length > 0 && (
      <ul class="font-body text-text list-disc pl-5 mt-2">
        {list.map(item => (
          <li class="pb-4">{item}</li>
        ))}
      </ul>
    )}
  </div>
</section>
