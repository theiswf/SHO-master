---
import PaperCard from './PaperCard.astro';
---
<!-- Carousel with fixed arrows + PaperCard slides -->
<div class="relative w-full" id="carouselRoot">

    <!-- FIXED ARROWS (always on top) -->
    <div class="absolute inset-0 flex items-center justify-between px-4 z-50 pointer-events-none ">
      <button
        id="prevBtn"
        class="pointer-events-auto p-2"
        aria-label="Previous"
        onclick="go(-1)"
      >
        <img src="/arrow.svg" alt="Previous" class="rotate-180 w-5 md:w-8 cursor-pointer">
      </button>
  
      <button
        id="nextBtn"
        class="pointer-events-auto p-2"
        aria-label="Next"
        onclick="go(1)"
      >
        <img src="/arrow.svg" alt="Next" class="w-5 md:w-8 cursor-pointer">
      </button>
    </div>
  
    <!-- Slides (use DaisyUI carousel-item or simple anchors) -->
    <div class="carousel w-full">
  
      <div id="slide1" class="carousel-item relative w-full flex items-center justify-center z-0">
        <!-- small rotation wrapper -->
        <div class="rotate-1">
          <!-- PaperCard -->
          <section class="relative inline-block w-[250px] md:w-[700px] m-5 py-16">
            <!-- background (z-0) -->
            <img class="absolute inset-0 w-full h-full object-cover drop-shadow-lg z-0" src="/paper-card.svg" alt="Paper Card">
  
            <!-- tape (above BG, below content) -->
            <img class="absolute top-0 left-1/2 -translate-x-1/2 z-20" src="/tape.svg" alt="tape">
  
            <!-- content (above BG) -->
            <div class="relative z-10 flex flex-col md:grid md:grid-cols-2 gap-4 pt-16 px-5 pb-5 min-h-[220px]">
              <div class="flex justify-center">
                <img class="w-[180px] h-[180px] md:w-[260px] md:h-[260px] object-cover rounded-md" src="/cardeventsindex.png.webp" alt="">
              </div>
  
              <div class="flex flex-col min-w-0">
                <h2 class="font-subheader text-black text-sm md:text-base truncate">13. December</h2>
                <h1 class="font-body font-bold text-black text-2xl md:text-4xl break-words">J-Dag</h1>
                <p class="font-body text-black text-xs md:text-base mt-2 leading-snug break-words">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque pulvinar sapien odio, in iaculis ligula porta ac.
                </p>
                <div class="pt-4 flex justify-center md:justify-start">
                  <button class="px-4 py-2 bg-black text-white rounded">Læs</button>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
  
      <div id="slide2" class="carousel-item relative w-full flex items-center justify-center z-0">
        <div class="-rotate-1">
          <section class="relative inline-block w-[250px] md:w-[700px] m-5 py-16">
            <img class="absolute inset-0 w-full h-full object-cover drop-shadow-lg z-0" src="/paper-card.svg" alt="Paper Card">
            <img class="absolute top-0 left-1/2 -translate-x-1/2 z-20" src="/tape.svg" alt="tape">
            <div class="relative z-10 flex flex-col md:grid md:grid-cols-2 gap-4 pt-16 px-5 pb-5 min-h-[220px]">
              <div class="flex justify-center">
                <img class="w-[180px] h-[180px] md:w-[260px] md:h-[260px] object-cover rounded-md" src="/cardeventsindex.png.webp" alt="">
              </div>
              <div class="flex flex-col min-w-0">
                <h2 class="font-subheader text-black text-sm md:text-base truncate">16. December</h2>
                <h1 class="font-body font-bold text-black text-2xl md:text-4xl break-words">Queer Cafe</h1>
                <p class="font-body text-black text-xs md:text-base mt-2 leading-snug break-words">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque pulvinar sapien odio...
                </p>
                <div class="pt-4 flex justify-center md:justify-start">
                  <button class="px-4 py-2 bg-black text-white rounded">Læs</button>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
  
      <div id="slide3" class="carousel-item relative w-full flex items-center justify-center z-0">
        <div class="-rotate-1.5">
          <section class="relative inline-block w-[250px] md:w-[700px] m-5 py-16">
            <img class="absolute inset-0 w-full h-full object-cover drop-shadow-lg z-0" src="/paper-card.svg" alt="Paper Card">
            <img class="absolute top-0 left-1/2 -translate-x-1/2 z-20" src="/tape.svg" alt="tape">
            <div class="relative z-10 flex flex-col md:grid md:grid-cols-2 gap-4 pt-16 px-5 pb-5 min-h-[220px]">
              <div class="flex justify-center">
                <img class="w-[180px] h-[180px] md:w-[260px] md:h-[260px] object-cover rounded-md" src="/cardeventsindex.png.webp" alt="">
              </div>
              <div class="flex flex-col min-w-0">
                <h2 class="font-subheader text-black text-sm md:text-base truncate">18. December</h2>
                <h1 class="font-body font-bold text-black text-2xl md:text-4xl break-words">Julefrokost</h1>
                <p class="font-body text-black text-xs md:text-base mt-2 leading-snug break-words">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque pulvinar sapien odio...
                </p>
                <div class="pt-4 flex justify-center md:justify-start">
                  <button class="px-4 py-2 bg-black text-white rounded">Læs</button>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
  
      <div id="slide4" class="carousel-item relative w-full flex items-center justify-center z-0">
        <div class="rotate-1">
          <section class="relative inline-block w-[250px] md:w-[700px] m-5 py-16">
            <img class="absolute inset-0 w-full h-full object-cover drop-shadow-lg z-0" src="/paper-card.svg" alt="Paper Card">
            <img class="absolute top-0 left-1/2 -translate-x-1/2 z-20" src="/tape.svg" alt="tape">
            <div class="relative z-10 flex flex-col md:grid md:grid-cols-2 gap-4 pt-16 px-5 pb-5 min-h-[220px]">
              <div class="flex justify-center">
                <img class="w-[180px] h-[180px] md:w-[260px] md:h-[260px] object-cover rounded-md" src="/cardeventsindex.png.webp" alt="">
              </div>
              <div class="flex flex-col min-w-0">
                <h2 class="font-subheader text-black text-sm md:text-base truncate">19. December</h2>
                <h1 class="font-body font-bold text-black text-2xl md:text-4xl break-words">Open Jam</h1>
                <p class="font-body text-black text-xs md:text-base mt-2 leading-snug break-words">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Quisque pulvinar sapien odio...
                </p>
                <div class="pt-4 flex justify-center md:justify-start">
                  <button class="px-4 py-2 bg-black text-white rounded">Læs</button>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
  
    </div> <!-- end carousel -->
  </div>
  
  <script>
    // tiny helper navigation so external arrows control anchored slides
    (function () {
      // ids in the order you want to cycle
      const slides = ['#slide1', '#slide2', '#slide3', '#slide4'];
  
      // normalize current hash to slides[0] if not present
      function currentIndex() {
        const h = location.hash || '#slide1';
        const idx = slides.indexOf(h);
        return idx >= 0 ? idx : 0;
      }
  
      window.go = function(dir) {
        const idx = currentIndex();
        const next = slides[(idx + dir + slides.length) % slides.length];
        // change the hash - this will jump to the anchored slide (DaisyUI carousel)
        location.hash = next;
      };
  
      // optional: ensure starting hash exists
      if (!slides.includes(location.hash)) {
        location.hash = slides[0];
      }
    })();
  </script>
  