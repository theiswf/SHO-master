<section class="mx-10 md:mx-50 lg:mx-80 pb-8">
    <h1 class="font-header font-bold text-mb-header md:text-header text-text text-center">Tilmeld dig vores Nyhedsbrev</h1>
    <form class="text-text">
        <div class="flex flex-col">
        <label class="text-mb-body md:text-body text-text font-body" for="name">Navn</label>
        <input class="focus:ring-0 rounded-lg border-2 placeholder:text-body border border-gray focus:border-black focus:outline-none transition-all duration-500" type="text" placeholder="Dit fulde navn" required/>
        </div>

      <div class="flex flex-col mt-4">
            <label class="text-mb-body md:text-body text-text font-body" for="email">Email</label>
            <input class="focus:ring-0 invalid:border-pink-500 invalid:text-pink-500 focus:invalid:border-pink-500 rounded-lg border-2 placeholder:text-body border border-gray focus:border-black focus:outline-none transition-all duration-500" type="email" placeholder="Enter your email" required />
            </div>
          <div class="pt-4">

    <div>
        <input class="focus:ring-0 rounded-sm border-2 border border-gray focus:border-black focus:outline-none transition-all duration-500" type="checkbox" id="consent" name="consent" required>
        <label for="consent" class="text-mb-body md:text-body text-text font-body ml-2">Jeg vil også gerne modtage tilbud om muligheder for at blive frivillig med hensyn til upcoming events, såsom f.eks Generator, Spoken Word, Tinderbox, osv. </label>
    </div>
<div class ="flex justify-center">
    <button type="submit" class="mt-4 text-center font-body font-bold py-2 px-32 bg-black border-2 border-black text-white rounded hover:bg-white hover:text-black duration-300 cursor-pointer">SEND ANSØGNING</button>
    
</div></div>  
</section>